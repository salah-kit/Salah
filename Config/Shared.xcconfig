// Settings shared by every target. Signing is per developer: copy
// Local.xcconfig.example to Local.xcconfig (gitignored) and set your team there.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// Salah's identity. The Mac, iOS and tvOS apps use the same identifier for one App Store
// record. Watch and extension targets append their own suffixes, and each app
// shares the App Group with its extensions; the entitlements and Info.plist files read
// both settings. Apple registers an identifier to one team, so to sign with another, name
// your own in Local.xcconfig.
APP_BUNDLE_IDENTIFIER = com.omarkhaled.salah
APP_GROUP_IDENTIFIER = group.com.omarkhaled.salah

#include? "Local.xcconfig"
