{
  "layout": {
    "$description": "Layout metrics for watchOS. Values are Apple points. DTCG dimensions allow only px and rem, so 1 px here means 1 pt (a density-independent point, the unit Figma and SwiftUI both use).",
    "margin": {
      "screen": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Leading and trailing margin of screens, windows and panels. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.marginScreen"
          }
        }
      }
    },
    "padding": {
      "card": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "Inner padding of cards and the hero. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.paddingCard"
          }
        }
      }
    },
    "gap": {
      "section": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Space between sections and cards. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.gapSection"
          }
        }
      },
      "stack": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "Space between items inside a card or row. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.gapStack"
          }
        }
      }
    },
    "row": {
      "height": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Minimum height of a list row. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.rowHeight"
          }
        }
      },
      "padding-h": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Horizontal padding inside a row. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.rowPaddingH"
          }
        }
      },
      "padding-v": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "Vertical padding inside a row. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.rowPaddingV"
          }
        }
      }
    },
    "control": {
      "height": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Large button height (glass and prominent). Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.controlHeight"
          }
        }
      },
      "height-small": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$description": "Small button and chip height. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.controlHeightSmall"
          }
        }
      }
    },
    "hit-target": {
      "min": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Minimum interactive size. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.hitTargetMin"
          }
        }
      }
    },
    "icon": {
      "row": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "Icon box in rows (SF Symbol at the row text style). Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.iconRow"
          }
        }
      }
    },
    "radius": {
      "card": {
        "$type": "dimension",
        "$value": {
          "value": 22,
          "unit": "px"
        },
        "$description": "Cards, the hero and grouped list sections. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.radiusCard"
          }
        }
      },
      "container": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "px"
        },
        "$description": "Sheets, panels, popovers and windows. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.radiusContainer"
          }
        }
      },
      "row-highlight": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Highlight behind a selected or next row. Values per platform mode.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": "SalahLayout.radiusRowHighlight"
          }
        }
      }
    }
  }
}
