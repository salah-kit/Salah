{
  "effects": {
    "$description": "Elevation, focus, materials and Liquid Glass. Shadow colors reference the color files, so load one of them. Values are Apple points. DTCG dimensions allow only px and rem, so 1 px here means 1 pt (a density-independent point, the unit Figma and SwiftUI both use).",
    "elevation": {
      "raised": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{color.shadow.ambient}",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 1,
              "unit": "px"
            },
            "blur": {
              "value": 2,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          },
          {
            "color": "{color.shadow.ambient}",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 2,
              "unit": "px"
            },
            "blur": {
              "value": 8,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          }
        ],
        "$description": "Cards that sit on a sky or on the grouped background. SwiftUI .shadow(color: SalahColor.shadowAmbient, radius: 4, y: 2) — or none, when a card already contrasts.",
        "$extensions": {
          "io.github.salah-kit": {
            "figmaStyle": "Elevation/Raised"
          }
        }
      },
      "floating": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{color.shadow.ambient}",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 1,
              "unit": "px"
            },
            "blur": {
              "value": 3,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          },
          {
            "color": "{color.shadow.key}",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 8,
              "unit": "px"
            },
            "blur": {
              "value": 24,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          }
        ],
        "$description": "Popovers, menus, the macOS dropdown panel and floating glass bars. The system draws these shadows for native surfaces; use only on custom floating views.",
        "$extensions": {
          "io.github.salah-kit": {
            "figmaStyle": "Elevation/Floating"
          }
        }
      },
      "overlay": {
        "$type": "shadow",
        "$value": [
          {
            "color": "{color.shadow.ambient}",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 2,
              "unit": "px"
            },
            "blur": {
              "value": 6,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          },
          {
            "color": "{color.shadow.key}",
            "offsetX": {
              "value": 0,
              "unit": "px"
            },
            "offsetY": {
              "value": 20,
              "unit": "px"
            },
            "blur": {
              "value": 48,
              "unit": "px"
            },
            "spread": {
              "value": 0,
              "unit": "px"
            }
          }
        ],
        "$description": "Sheets, alerts and windows. System-drawn on native surfaces; reference only.",
        "$extensions": {
          "io.github.salah-kit": {
            "figmaStyle": "Elevation/Overlay"
          }
        }
      }
    },
    "focus": {
      "ring": {
        "$type": "shadow",
        "$value": {
          "color": "{color.accent.default}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 3.5,
            "unit": "px"
          }
        },
        "$description": "macOS keyboard focus ring: 3.5 pt outside the shape in the accent color (the system draws it with .focusable(); the app accent is gold).",
        "$extensions": {
          "io.github.salah-kit": {
            "figmaStyle": "Focus/Ring"
          }
        }
      }
    },
    "material": {
      "thin": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": ".thinMaterial. Pair with a translucent fill (glass/fill). Under Reduce Transparency use material/opaque-thin. The value is the background blur radius of the Figma drawing.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": ".thinMaterial",
            "figmaStyle": "Material/Thin",
            "tint": "{color.glass.fill}",
            "reduceTransparencyFallback": "{color.material.opaque-thin}"
          }
        }
      },
      "regular": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "px"
        },
        "$description": ".regularMaterial. Pair with glass/fill. Under Reduce Transparency use material/opaque. The value is the background blur radius of the Figma drawing.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": ".regularMaterial",
            "figmaStyle": "Material/Regular",
            "tint": "{color.glass.fill}",
            "reduceTransparencyFallback": "{color.material.opaque}"
          }
        }
      },
      "thick": {
        "$type": "dimension",
        "$value": {
          "value": 50,
          "unit": "px"
        },
        "$description": ".thickMaterial. Pair with glass/fill. Under Reduce Transparency use material/opaque-thick. The value is the background blur radius of the Figma drawing.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": ".thickMaterial",
            "figmaStyle": "Material/Thick",
            "tint": "{color.glass.fill}",
            "reduceTransparencyFallback": "{color.material.opaque-thick}"
          }
        }
      }
    },
    "glass": {
      "regular": {
        "$description": "Liquid Glass, regular: tab bars, toolbars, buttons and controls in the navigation layer. Code: .glassEffect(.regular) or a .glass / .glassProminent button style. Never on the content layer. Under Reduce Transparency the system makes it opaque (material/opaque).",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": ".glassEffect(.regular)",
            "figmaStyle": "Glass/Regular",
            "figmaGlass": {
              "radius": 6,
              "refraction": 0.6,
              "depth": 18,
              "dispersion": 0.25,
              "lightIntensity": 0.6,
              "lightAngle": -45
            },
            "rim": "{color.glass.stroke}",
            "highlight": "{color.glass.highlight}",
            "reduceTransparencyFallback": "{color.material.opaque}"
          }
        }
      },
      "clear": {
        "$description": "Liquid Glass, clear: controls over rich media (the Qibla dial, StandBy). Code: .glassEffect(.clear). Needs a dimming layer underneath when content is bright.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": ".glassEffect(.clear)",
            "figmaStyle": "Glass/Clear",
            "figmaGlass": {
              "radius": 1,
              "refraction": 0.75,
              "depth": 22,
              "dispersion": 0.35,
              "lightIntensity": 0.5,
              "lightAngle": -45
            },
            "rim": "{color.glass.stroke}",
            "highlight": "{color.glass.highlight}",
            "reduceTransparencyFallback": "{color.material.opaque}"
          }
        }
      },
      "tinted": {
        "$description": "Liquid Glass tinted with the accent: the prominent Stop control. Code: .glassEffect(.regular.tint(SalahColor.accentFill)). Pair with an accent/fill layer at ~35%.",
        "$extensions": {
          "io.github.salah-kit": {
            "swift": ".glassEffect(.regular.tint(SalahColor.accentFill))",
            "figmaStyle": "Glass/Tinted",
            "figmaGlass": {
              "radius": 6,
              "refraction": 0.6,
              "depth": 18,
              "dispersion": 0.25,
              "lightIntensity": 0.6,
              "lightAngle": -45
            },
            "rim": "{color.glass.stroke}",
            "highlight": "{color.glass.highlight}",
            "reduceTransparencyFallback": "{color.material.opaque}",
            "tint": "{color.accent.fill}"
          }
        }
      }
    }
  }
}
