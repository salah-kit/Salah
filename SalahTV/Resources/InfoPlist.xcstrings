    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used once to find your city and its time zone for prayer times. You can choose a city instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُستخدم موقعك مرة واحدة لمعرفة مدينتك ومنطقتها الزمنية من أجل أوقات الصلاة. يمكنك اختيار مدينة بدلاً من ذلك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre position sert une seule fois à trouver votre ville et son fuseau horaire pour les heures de prière. Vous pouvez choisir une ville à la place."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نماز کے اوقات کی خاطر آپ کا شہر اور اس کا ٹائم زون معلوم کرنے کے لیے آپ کا مقام ایک بار استعمال ہوتا ہے۔ آپ اس کے بجائے شہر منتخب کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi Anda digunakan sekali untuk menemukan kota dan zona waktunya bagi waktu salat. Anda juga dapat memilih kota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konumunuz, namaz vakitleri için şehrinizi ve saat dilimini bulmak üzere bir kez kullanılır. Bunun yerine bir şehir seçebilirsiniz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "از موقعیت شما یک بار برای یافتن شهر و منطقه زمانی آن جهت اوقات نماز استفاده می‌شود. می‌توانید به‌جای آن شهری را انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নামাজের সময়ের জন্য আপনার শহর ও তার সময় অঞ্চল খুঁজতে আপনার অবস্থান একবার ব্যবহার করা হয়। এর পরিবর্তে আপনি একটি শহর বেছে নিতে পারেন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi anda digunakan sekali untuk mencari bandar anda dan zon waktunya bagi waktu solat. Anda boleh memilih bandar sebagai ganti."
          }
        }
      }
    }
  },
  "version": "1.0"
}
