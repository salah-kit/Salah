    "Choose a place in Salah on your iPhone. Its prayer times appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a place in Salah on your iPhone. Its prayer times appear here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر مكانًا في تطبيق صلاة على جهاز iPhone لتظهر أوقات الصلاة هنا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un lieu dans Salah sur votre iPhone. Ses horaires de prière s’affichent ici."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپنے iPhone پر Salah میں ایک جگہ منتخب کریں۔ اس کے نماز کے اوقات یہاں ظاہر ہوں گے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih tempat di Salah pada iPhone Anda. Waktu salatnya muncul di sini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone’unuzdaki Salah’ta bir yer seçin. Namaz vakitleri burada görünür."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "در Salah روی iPhone خود مکانی انتخاب کنید. اوقات نماز آن اینجا نمایش داده می‌شود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার iPhone-এ Salah-এ একটি স্থান বেছে নিন। এর নামাজের সময় এখানে দেখা যাবে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih tempat dalam Salah pada iPhone anda. Waktu solatnya dipaparkan di sini."
          }
        }
      }
    },
