    "Times may differ from your mosque’s timetable. Check your local calculation convention before changing angles.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times may differ from your mosque’s timetable. Check your local calculation convention before changing angles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد تختلف المواقيت عن جدول مسجدك. تحقق من طريقة الحساب المحلية قبل تغيير الزوايا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les horaires peuvent différer de ceux de votre mosquée. Vérifiez la convention locale avant de modifier les angles."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقات آپ کی مسجد کے جدول سے مختلف ہو سکتے ہیں۔ زاویے بدلنے سے پہلے مقامی حساب کا طریقہ چیک کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu dapat berbeda dari jadwal masjid Anda. Periksa konvensi perhitungan setempat sebelum mengubah sudut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vakitler caminizin takviminden farklı olabilir. Açıları değiştirmeden önce yerel hesaplama usulünü kontrol edin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ممکن است اوقات با جدول مسجد شما متفاوت باشد. پیش از تغییر زاویه‌ها، روش محاسبه محلی را بررسی کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সময় আপনার মসজিদের সময়সূচি থেকে ভিন্ন হতে পারে। কোণ বদলানোর আগে স্থানীয় গণনার রীতি যাচাই করুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu mungkin berbeza daripada jadual masjid anda. Semak amalan pengiraan setempat sebelum menukar sudut."
          }
        }
      }
    },
