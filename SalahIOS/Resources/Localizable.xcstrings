        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم العثور على مدن. جرّب اسم المدينة والدولة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune ville trouvée. Essayez le nom d’une ville et d’un pays."
