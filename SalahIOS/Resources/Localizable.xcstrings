    "Your alert choices are saved. Allow notifications in iPhone Settings to receive them. Focus and Scheduled Summary can affect when banners appear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your alert choices are saved. Allow notifications in iPhone Settings to receive them. Focus and Scheduled Summary can affect when banners appear."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُحفظ اختيارات التنبيهات. اسمح بالإشعارات في إعدادات iPhone لاستلامها. قد يؤثر التركيز والملخص المجدول في وقت ظهور اللافتات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos choix sont enregistrés. Autorisez les notifications dans les réglages de l’iPhone pour les recevoir. Concentration et le résumé programmé peuvent modifier l’affichage des bannières."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کی تنبیہات کے انتخاب محفوظ ہیں۔ انہیں پانے کے لیے iPhone کی ترتیبات میں اطلاعات کی اجازت دیں۔ فوکس اور مقررہ خلاصہ بینر کے وقت کو متاثر کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilihan peringatan Anda tersimpan. Izinkan notifikasi di Pengaturan iPhone untuk menerimanya. Fokus dan Ringkasan Terjadwal dapat memengaruhi waktu munculnya spanduk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uyarı tercihleriniz kaydedildi. Almak için iPhone Ayarları’ndan bildirimlere izin verin. Odak ve Zamanlanmış Özet, başlıkların görünme zamanını etkileyebilir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتخاب‌های هشدار شما ذخیره شده‌اند. برای دریافت، در تنظیمات iPhone اجازه اعلان بدهید. تمرکز و خلاصه زمان‌بندی‌شده ممکن است زمان نمایش بنرها را تغییر دهند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সতর্কতার পছন্দ সংরক্ষিত আছে। পেতে iPhone সেটিংসে বিজ্ঞপ্তির অনুমতি দিন। ফোকাস ও নির্ধারিত সারাংশ ব্যানার দেখানোর সময়ে প্রভাব ফেলতে পারে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilihan peringatan anda disimpan. Benarkan pemberitahuan dalam Seting iPhone untuk menerimanya. Fokus dan Ringkasan Berjadual boleh mempengaruhi masa sepanduk muncul."
          }
        }
      }
    },
    "Your choice applies to this alert only. Reminders have their own sounds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choice applies to this alert only. Reminders have their own sounds."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينطبق اختيارك على هذا التنبيه فقط. للتذكيرات أصواتها الخاصة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre choix s’applique uniquement à cette alerte. Les rappels ont leurs propres sons."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کا انتخاب صرف اس تنبیہ پر لاگو ہوتا ہے۔ یاد دہانیوں کی اپنی آوازیں ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilihan Anda hanya berlaku untuk peringatan ini. Pengingat memiliki suaranya sendiri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seçiminiz yalnızca bu uyarıya uygulanır. Hatırlatıcıların kendi sesleri vardır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتخاب شما فقط برای این هشدار است. یادآورها صداهای خودشان را دارند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই পছন্দ শুধু এই সতর্কতায় প্রযোজ্য। স্মরণবার্তার শব্দ আলাদা।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilihan anda hanya terpakai pada peringatan ini. Pengingat mempunyai bunyinya sendiri."
          }
        }
      }
    },
