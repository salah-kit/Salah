    "Alerts are scheduled on this iPhone. If notifications are off, Salah still shows the times.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are scheduled on this iPhone. If notifications are off, Salah still shows the times."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُجدول التنبيهات على iPhone. إذا كانت الإشعارات معطلة، يظل تطبيق صلاة يعرض المواقيت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les alertes sont programmées sur cet iPhone. Si les notifications sont désactivées, Salah affiche toujours les horaires."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنبیہات اسی iPhone پر مقرر ہیں۔ اطلاعات بند ہونے پر بھی Salah اوقات دکھاتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peringatan dijadwalkan di iPhone ini. Jika notifikasi nonaktif, Salah tetap menampilkan waktunya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uyarılar bu iPhone’da zamanlanır. Bildirimler kapalı olsa da Salah vakitleri gösterir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هشدارها روی این iPhone زمان‌بندی می‌شوند. اگر اعلان‌ها خاموش باشند، Salah همچنان اوقات را نمایش می‌دهد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই iPhone-এ সতর্কতা নির্ধারিত হয়। বিজ্ঞপ্তি বন্ধ থাকলেও Salah সময় দেখায়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peringatan dijadualkan pada iPhone ini. Jika pemberitahuan dimatikan, Salah masih menunjukkan waktu."
          }
        }
      }
    },
    "Alerts could not be scheduled. Open Salah again to retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
