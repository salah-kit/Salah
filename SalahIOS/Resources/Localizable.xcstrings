    "Your location’s Qibla bearing is shown above. A true-north compass reading is not available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location’s Qibla bearing is shown above. A true-north compass reading is not available on this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يظهر اتجاه القبلة لموقعك أعلاه. لا تتوفر قراءة بوصلة من الشمال الحقيقي على هذا الجهاز."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La direction de la qibla pour votre lieu est affichée ci-dessus. Une mesure de boussole du nord vrai n’est pas disponible sur cet appareil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کے مقام کی قبلے کی سمت اوپر دکھائی گئی ہے۔ اس آلے پر حقیقی شمال کی قطب نما پیمائش دستیاب نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arah kiblat lokasi Anda ditampilkan di atas. Pembacaan kompas utara sejati tidak tersedia di perangkat ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konumunuzun kıble yönü yukarıda gösterilir. Bu aygıtta gerçek kuzeye göre pusula okuması kullanılamıyor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جهت قبله موقعیت شما در بالا نشان داده شده است. خوانش قطب‌نمای شمال حقیقی روی این دستگاه در دسترس نیست."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অবস্থানের কিবলার দিক ওপরে দেখানো হয়েছে। এই ডিভাইসে প্রকৃত উত্তরের কম্পাস পাঠ পাওয়া যাচ্ছে না।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arah kiblat lokasi anda ditunjukkan di atas. Bacaan kompas utara benar tidak tersedia pada peranti ini."
          }
        }
      }
    },
