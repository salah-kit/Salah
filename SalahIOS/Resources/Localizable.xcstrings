    "Location access is off. Choose a city to calculate its times, or allow location in iPhone Settings. Your selected city remains available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Choose a city to calculate its times, or allow location in iPhone Settings. Your selected city remains available."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوصول إلى الموقع معطّل. اختر مدينة لحساب مواقيتها، أو اسمح بالموقع في إعدادات iPhone. تبقى مدينتك المختارة متاحة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à la position est désactivé. Choisissez une ville ou autorisez la localisation dans les réglages de l’iPhone. Votre ville sélectionnée reste disponible."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مقام تک رسائی بند ہے۔ اوقات کے حساب کے لیے شہر منتخب کریں یا iPhone کی ترتیبات میں مقام کی اجازت دیں۔ منتخب شہر دستیاب رہے گا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi nonaktif. Pilih kota untuk menghitung waktunya atau izinkan lokasi di Pengaturan iPhone. Kota pilihan Anda tetap tersedia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konum erişimi kapalı. Vakitleri hesaplamak için bir şehir seçin veya iPhone Ayarları’ndan konuma izin verin. Seçtiğiniz şehir kullanılabilir kalır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دسترسی به موقعیت خاموش است. برای محاسبه اوقات شهری انتخاب کنید یا در تنظیمات iPhone اجازه موقعیت بدهید. شهر انتخابی شما در دسترس می‌ماند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অবস্থান ব্যবহারের অনুমতি বন্ধ। সময় গণনার জন্য শহর বেছে নিন অথবা iPhone সেটিংসে অনুমতি দিন। নির্বাচিত শহরটি ব্যবহার করতে পারবেন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi dimatikan. Pilih bandar untuk mengira waktunya, atau benarkan lokasi dalam Seting iPhone. Bandar pilihan anda kekal tersedia."
          }
        }
      }
    },
    "Location access is off. Enable it in Settings or choose a city.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Enable it in Settings or choose a city."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوصول إلى الموقع متوقف. فعّله من الإعدادات أو اختر مدينة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à la position est désactivé. Activez-le dans Réglages ou choisissez une ville."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مقام تک رسائی بند ہے۔ اسے ترتیبات میں فعال کریں یا شہر منتخب کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi nonaktif. Aktifkan di Pengaturan atau pilih kota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konum erişimi kapalı. Ayarlar’dan açın veya bir şehir seçin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دسترسی به موقعیت خاموش است. آن را در تنظیمات روشن کنید یا شهری انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অবস্থান ব্যবহারের অনুমতি বন্ধ। সেটিংসে চালু করুন অথবা শহর বেছে নিন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi dimatikan. Hidupkan dalam Seting atau pilih bandar."
          }
        }
      }
    },
    "Location access is optional. Choose a city for prayer times and the Qibla.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is optional. Choose a city for prayer times and the Qibla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوصول إلى الموقع اختياري. اختر مدينة لمواقيت الصلاة والقبلة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La localisation est facultative. Choisissez une ville pour les horaires et la qibla."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مقام کی اجازت اختیاری ہے۔ اوقاتِ نماز اور قبلے کے لیے شہر منتخب کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi bersifat opsional. Pilih kota untuk waktu salat dan kiblat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konum erişimi isteğe bağlıdır. Namaz vakitleri ve kıble için bir şehir seçin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دسترسی به موقعیت اختیاری است. برای اوقات نماز و قبله شهری انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অবস্থানের অনুমতি ঐচ্ছিক। নামাজের সময় ও কিবলার জন্য শহর বেছে নিন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi adalah pilihan. Pilih bandar untuk waktu solat dan kiblat."
          }
        }
      }
    },
