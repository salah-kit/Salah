        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 1–120 minutes. Each reminder keeps its own timing and sound."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر من ١ إلى ١٢٠ دقيقة. لكل تذكير توقيته وصوته المستقلان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez de 1 à 120 minutes. Chaque rappel garde son horaire et son son propres."
          }
