    "Prayer times are calculated on this iPhone. Current location uses Apple’s location services; city searches use Apple Maps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times are calculated on this iPhone. Current location uses Apple’s location services; city searches use Apple Maps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُحسب مواقيت الصلاة على iPhone. يستخدم الموقع الحالي خدمات الموقع من Apple، ويستخدم البحث عن المدن خرائط Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les horaires sont calculés sur cet iPhone. La position actuelle utilise les services de localisation d’Apple ; les recherches de villes utilisent Plans d’Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقاتِ نماز اسی iPhone پر حساب کیے جاتے ہیں۔ موجودہ مقام Apple کی مقام کی خدمات اور شہر کی تلاش Apple Maps استعمال کرتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu salat dihitung di iPhone ini. Lokasi saat ini menggunakan layanan lokasi Apple; pencarian kota menggunakan Apple Maps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Namaz vakitleri bu iPhone’da hesaplanır. Geçerli konum, Apple’ın konum servislerini; şehir aramaları Apple Harita’yı kullanır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقات نماز روی این iPhone محاسبه می‌شود. موقعیت کنونی از خدمات موقعیت Apple و جستجوی شهر از نقشه‌های Apple استفاده می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই iPhone-এই নামাজের সময় গণনা করা হয়। বর্তমান অবস্থানে Apple-এর অবস্থান সেবা, শহরের অনুসন্ধানে Apple Maps ব্যবহৃত হয়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu solat dikira pada iPhone ini. Lokasi semasa menggunakan perkhidmatan lokasi Apple; carian bandar menggunakan Peta Apple."
          }
        }
      }
    },
    "Prayer times are unavailable for this location and date. Review calculation settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times are unavailable for this location and date. Review calculation settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أوقات الصلاة غير متاحة لهذا الموقع والتاريخ. راجع إعدادات الحساب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les horaires sont indisponibles pour ce lieu et cette date. Vérifiez les réglages de calcul."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس مقام اور تاریخ کے لیے اوقاتِ نماز دستیاب نہیں۔ حساب کی ترتیبات دیکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu salat tidak tersedia untuk lokasi dan tanggal ini. Tinjau pengaturan perhitungan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu konum ve tarih için namaz vakitleri yok. Hesaplama ayarlarını gözden geçirin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقات نماز برای این موقعیت و تاریخ در دسترس نیست. تنظیمات محاسبه را بررسی کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই অবস্থান ও তারিখের জন্য নামাজের সময় পাওয়া যাচ্ছে না। গণনার সেটিংস দেখুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu solat tidak tersedia untuk lokasi dan tarikh ini. Semak seting pengiraan."
          }
        }
      }
    },
    "Prayer times, Qibla and reminders, calculated on your iPhone. Built on the open Salah Kit prayer-time engine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times, Qibla and reminders, calculated on your iPhone. Built on the open Salah Kit prayer-time engine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مواقيت الصلاة والقبلة والتذكيرات، تُحسب على iPhone. يعتمد على محرك حساب الصلاة المفتوح Salah Kit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Horaires de prière, qibla et rappels, calculés sur votre iPhone. Basé sur le moteur ouvert Salah Kit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقاتِ نماز، قبلہ اور یاد دہانیاں، آپ کے iPhone پر حساب کیے جاتے ہیں۔ کھلے Salah Kit انجن پر مبنی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu salat, kiblat, dan pengingat, dihitung di iPhone Anda. Dibangun dengan mesin waktu salat terbuka Salah Kit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Namaz vakitleri, kıble ve hatırlatıcılar iPhone’unuzda hesaplanır. Açık kaynak Salah Kit vakit motoruyla çalışır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقات نماز، قبله و یادآورها روی iPhone شما محاسبه می‌شوند. بر پایه موتور متن‌باز اوقات نماز Salah Kit."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নামাজের সময়, কিবলা ও স্মরণবার্তা, আপনার iPhone-এ গণনা করা হয়। উন্মুক্ত Salah Kit নামাজের সময় গণনা ইঞ্জিনভিত্তিক।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu solat, kiblat dan pengingat, dikira pada iPhone anda. Dibina berasaskan enjin waktu solat terbuka Salah Kit."
          }
        }
      }
    },
