    "The sky follows the prayer period, from dawn to night. Turn this off for a neutral sky with a gold accent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky follows the prayer period, from dawn to night. Turn this off for a neutral sky with a gold accent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتبع السماء فترة الصلاة من الفجر إلى الليل. عطّل هذا الخيار لسماء محايدة بلمسة ذهبية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le ciel suit la période de prière, de l’aube à la nuit. Désactivez cette option pour un ciel neutre avec un accent doré."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آسمان فجر سے رات تک نماز کے وقت کے مطابق بدلتا ہے۔ سنہری جھلک کے ساتھ غیر جانب دار آسمان کے لیے اسے بند کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langit mengikuti periode salat, dari fajar hingga malam. Nonaktifkan untuk langit netral dengan aksen emas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gökyüzü, şafaktan geceye namaz dilimini izler. Altın vurgulu nötr bir gökyüzü için bunu kapatın."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آسمان از سپیده‌دم تا شب از بازه نماز پیروی می‌کند. برای آسمان خنثی با رنگ طلایی، این گزینه را خاموش کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আকাশ ভোর থেকে রাত পর্যন্ত নামাজের সময়পর্ব অনুসরণ করে। সোনালি আভাসহ নিরপেক্ষ আকাশের জন্য এটি বন্ধ করুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langit mengikut tempoh solat, dari fajar hingga malam. Matikan untuk langit neutral dengan aksen emas."
          }
        }
      }
    },
