    "Times follow the city’s time zone. You can change the city later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times follow the city’s time zone. You can change the city later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتبع المواقيت المنطقة الزمنية للمدينة. يمكنك تغيير المدينة لاحقًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les horaires suivent le fuseau de la ville. Vous pourrez la changer plus tard."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقات شہر کے ٹائم زون کے مطابق ہیں۔ آپ بعد میں شہر بدل سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu mengikuti zona waktu kota. Anda dapat mengubah kota nanti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vakitler şehrin saat dilimine uyar. Şehri daha sonra değiştirebilirsiniz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقات از منطقه زمانی شهر پیروی می‌کنند. بعداً می‌توانید شهر را تغییر دهید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সময় শহরের সময় অঞ্চল অনুসরণ করে। পরে শহর বদলাতে পারবেন।"
