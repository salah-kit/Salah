          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسمح بالوصول إلى الموقع، أو اختر مدينة لمعرفة اتجاه القبلة فيها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez la localisation ou choisissez une ville pour sa direction de la qibla."
