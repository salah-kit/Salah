    "Hold your device flat, away from metal and magnets. The Qibla is measured from true north.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your device flat, away from metal and magnets. The Qibla is measured from true north."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أمسك الجهاز بشكل مسطّح وبعيدًا عن المعادن والمغناطيس. يُقاس اتجاه القبلة من الشمال الحقيقي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tenez l’appareil à plat, loin du métal et des aimants. La qibla est mesurée depuis le nord vrai."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آلے کو سیدھا رکھیں اور دھات اور مقناطیس سے دور رکھیں۔ قبلے کی سمت حقیقی شمال سے ناپی جاتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pegang perangkat mendatar, jauh dari logam dan magnet. Kiblat diukur dari utara sejati."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aygıtınızı düz tutun, metal ve mıknatıslardan uzaklaştırın. Kıble, gerçek kuzeyden ölçülür."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دستگاه را صاف و دور از فلز و آهن‌ربا نگه دارید. قبله از شمال حقیقی اندازه‌گیری می‌شود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ডিভাইসটি সমতলভাবে, ধাতু ও চুম্বক থেকে দূরে ধরুন। কিবলা প্রকৃত উত্তর থেকে মাপা হয়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pegang peranti rata, jauh daripada logam dan magnet. Kiblat diukur dari utara benar."
          }
        }
      }
    },
