    "%@ is suggested for your location. You can change the method, the madhab for Asr and minute adjustments anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is suggested for your location. You can change the method, the madhab for Asr and minute adjustments anytime."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُقترح طريقة %@ لموقعك. يمكنك تغيير الطريقة ومذهب حساب العصر وتعديل الدقائق في أي وقت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est suggérée pour votre position. Vous pouvez modifier la méthode, l’école juridique de l’Asr et les ajustements en minutes à tout moment."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کے مقام کے لیے %@ تجویز کیا گیا ہے۔ آپ طریقہ، عصر کا مسلک اور منٹوں کی تبدیلیاں کسی بھی وقت بدل سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ disarankan untuk lokasi Anda. Metode, mazhab Asar, dan penyesuaian menit dapat diubah kapan saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konumunuz için %@ önerilir. Yöntemi, ikindi mezhebini ve dakika düzeltmelerini istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ برای موقعیت شما پیشنهاد می‌شود. هر زمان می‌توانید روش، مذهب عصر و تنظیم دقیقه‌ها را تغییر دهید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অবস্থানের জন্য %@ প্রস্তাবিত। পদ্ধতি, আসরের মাজহাব ও মিনিটের সমন্বয় যেকোনো সময় বদলাতে পারবেন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ disyorkan untuk lokasi anda. Anda boleh menukar kaedah, mazhab Asar dan pelarasan minit pada bila-bila masa."
          }
        }
      }
    },
