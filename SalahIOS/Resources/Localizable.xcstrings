        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کی نماز کی تنبیہات محفوظ ہیں۔ انہیں پانے کے لیے ترتیبات میں اطلاعات فعال کریں۔ فوکس اور مقررہ خلاصہ ترسیل میں تاخیر کر سکتے ہیں۔"
