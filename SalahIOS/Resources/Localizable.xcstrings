    "Mute Salah sounds while keeping your notifications and reminders enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute Salah sounds while keeping your notifications and reminders enabled."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتم أصوات صلاة مع استمرار تفعيل الإشعارات والتذكيرات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coupez les sons de Salah en gardant les notifications et rappels actifs."
