    "When off, Fridays use Dhuhr’s alerts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, Fridays use Dhuhr’s alerts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند التعطيل، تستخدم الجمعة تنبيهات الظهر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé, le vendredi utilise les alertes du Dhuhr."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بند ہونے پر جمعے کو ظہر کی تنبیہات استعمال ہوتی ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika nonaktif, hari Jumat memakai peringatan Zuhur."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalıyken cuma günleri öğle uyarıları kullanılır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وقتی خاموش است، جمعه‌ها از هشدارهای ظهر استفاده می‌کنند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
