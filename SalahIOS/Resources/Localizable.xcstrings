    "For %@, %@ is suggested. You can change the method, the madhab for Asr and minute adjustments anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %@, %@ is suggested. You can change the method, the madhab for Asr and minute adjustments anytime."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُقترح طريقة %@ لـ%@. يمكنك تغيير الطريقة ومذهب حساب العصر وتعديل الدقائق في أي وقت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour %@, %@ est suggérée. Vous pouvez modifier la méthode, l’école juridique de l’Asr et les ajustements en minutes à tout moment."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ کے لیے %@ تجویز کیا گیا ہے۔ آپ طریقہ، عصر کا مسلک اور منٹوں کی تبدیلیاں کسی بھی وقت بدل سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Untuk %@, %@ disarankan. Metode, mazhab Asar, dan penyesuaian menit dapat diubah kapan saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ için %@ önerilir. Yöntemi, ikindi mezhebini ve dakika düzeltmelerini istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای %@، %@ پیشنهاد می‌شود. هر زمان می‌توانید روش، مذهب عصر و تنظیم دقیقه‌ها را تغییر دهید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-এর জন্য %@ প্রস্তাবিত। পদ্ধতি, আসরের মাজহাব ও মিনিটের সমন্বয় যেকোনো সময় বদলাতে পারবেন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Untuk %@, %@ disyorkan. Anda boleh menukar kaedah, mazhab Asar dan pelarasan minit pada bila-bila masa."
          }
        }
      }
    },
    "For methods that set Isha by an interval after Maghrib. Ramadan uses 120 minutes; angle-based Isha is unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For methods that set Isha by an interval after Maghrib. Ramadan uses 120 minutes; angle-based Isha is unchanged."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "للطرق التي تحدد العشاء بفاصل بعد المغرب. يُستخدم فاصل ١٢٠ دقيقة في رمضان؛ ولا يتغير العشاء المحسوب بالزاوية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour les méthodes qui fixent l’Isha par un intervalle après Maghrib. Le Ramadan utilise 120 minutes ; l’Isha calculé par angle ne change pas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ان طریقوں کے لیے جو مغرب کے بعد وقفے سے عشاء مقرر کرتے ہیں۔ رمضان میں ۱۲۰ منٹ استعمال ہوتے ہیں؛ زاویے سے حساب شدہ عشاء تبدیل نہیں ہوتی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Untuk metode yang menetapkan Isya dengan selang waktu setelah Magrib. Ramadan menggunakan 120 menit; Isya berbasis sudut tidak berubah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yatsıyı akşamdan sonraki bir süreyle belirleyen yöntemler içindir. Ramazan’da 120 dakika kullanılır; açıya dayalı yatsı değişmez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای روش‌هایی که عشا را با فاصله‌ای پس از مغرب تعیین می‌کنند. در رمضان ۱۲۰ دقیقه استفاده می‌شود؛ عشای مبتنی بر زاویه تغییر نمی‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "মাগরিবের পর নির্দিষ্ট বিরতিতে এশা নির্ধারণকারী পদ্ধতির জন্য। রমজানে ১২০ মিনিট ব্যবহৃত হয়; কোণভিত্তিক এশা অপরিবর্তিত থাকে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Untuk kaedah yang menetapkan Isyak mengikut sela selepas Maghrib. Ramadan menggunakan 120 minit; Isyak berdasarkan sudut tidak berubah."
          }
        }
      }
    },
