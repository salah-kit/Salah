    "Choose a calculation method. You can change the method, the madhab for Asr and minute adjustments anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a calculation method. You can change the method, the madhab for Asr and minute adjustments anytime."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر طريقة الحساب. يمكنك تغيير الطريقة ومذهب حساب العصر وتعديل الدقائق في أي وقت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez une méthode de calcul. Vous pouvez modifier la méthode, l’école juridique de l’Asr et les ajustements en minutes à tout moment."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حساب کا طریقہ منتخب کریں۔ آپ طریقہ، عصر کا مسلک اور منٹوں کی تبدیلیاں کسی بھی وقت بدل سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih metode perhitungan. Metode, mazhab Asar, dan penyesuaian menit dapat diubah kapan saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir hesaplama yöntemi seçin. Yöntemi, ikindi mezhebini ve dakika düzeltmelerini istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک روش محاسبه انتخاب کنید. هر زمان می‌توانید روش، مذهب عصر و تنظیم دقیقه‌ها را تغییر دهید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গণনার পদ্ধতি বেছে নিন। পদ্ধতি, আসরের মাজহাব ও মিনিটের সমন্বয় যেকোনো সময় বদলাতে পারবেন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih kaedah pengiraan. Anda boleh menukar kaedah, mazhab Asar dan pelarasan minit pada bila-bila masa."
          }
        }
      }
    },
