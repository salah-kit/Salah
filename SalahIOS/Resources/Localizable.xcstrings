          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر العثور على المنطقة الزمنية لهذا الموقع. تحقق من الاتصال أو اختر مدينة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le fuseau horaire de ce lieu est introuvable. Vérifiez votre connexion ou choisissez une ville."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس مقام کا ٹائم زون نہیں مل سکا۔ اپنا کنکشن چیک کریں یا شہر منتخب کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zona waktu lokasi ini tidak ditemukan. Periksa koneksi Anda atau pilih kota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu konumun saat dilimi bulunamadı. Bağlantınızı kontrol edin veya bir şehir seçin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منطقه زمانی این مکان یافت نشد. اتصال خود را بررسی کنید یا شهری انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই অবস্থানের সময় অঞ্চল পাওয়া যায়নি। সংযোগ পরীক্ষা করুন অথবা শহর বেছে নিন।"
