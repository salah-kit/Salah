    "Applies to the app and Home Screen widgets. iOS controls tinted and Lock Screen widget colors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the app and Home Screen widgets. iOS controls tinted and Lock Screen widget colors."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينطبق على التطبيق وأدوات الشاشة الرئيسية. يتحكم iOS بألوان الأدوات الملونة وأدوات شاشة القفل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S’applique à l’app et aux widgets de l’écran d’accueil. iOS gère les couleurs des widgets teintés et de l’écran verrouillé."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ ایپ اور ہوم اسکرین ویجٹس پر لاگو ہوتا ہے۔ رنگین اور لاک اسکرین ویجٹس کے رنگ iOS کنٹرول کرتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berlaku untuk app dan widget Layar Utama. iOS mengatur warna widget berwarna dan Layar Terkunci."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulamaya ve Ana Ekran araç takımlarına uygulanır. Renkli ve Kilit Ekranı araç takımı renklerini iOS yönetir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای برنامه و ابزارک‌های صفحه اصلی اعمال می‌شود. رنگ ابزارک‌های رنگی و صفحه قفل را iOS کنترل می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অ্যাপ ও হোম স্ক্রিনের উইজেটে প্রযোজ্য। রঙিন ও লক স্ক্রিনের উইজেটের রং iOS নিয়ন্ত্রণ করে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terpakai pada app dan widget Skrin Utama. iOS mengawal warna widget berwarna dan Skrin Kunci."
          }
        }
      }
    },
