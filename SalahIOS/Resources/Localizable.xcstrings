            "value": ", "
          }
        }
      }
    },
    "A custom method uses your Fajr and Isha angles. Asr, high-latitude rules and minute adjustments still apply.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom method uses your Fajr and Isha angles. Asr, high-latitude rules and minute adjustments still apply."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تستخدم الطريقة المخصصة زاويتي الفجر والعشاء اللتين تختارهما. تظل إعدادات العصر وخطوط العرض والتعديلات بالدقائق سارية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une méthode personnalisée utilise vos angles du Fajr et de l’Isha. Les règles de l’Asr, des hautes latitudes et les ajustements en minutes restent appliqués."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حسبِ ضرورت طریقہ آپ کے فجر اور عشاء کے زاویے استعمال کرتا ہے۔ عصر، بلند عرض بلد کے اصول اور منٹوں کی تبدیلیاں بھی لاگو رہتی ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metode kustom menggunakan sudut Subuh dan Isya Anda. Aturan Asar, lintang tinggi, dan penyesuaian menit tetap berlaku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Özel yöntem, imsak ve yatsı açılarınızı kullanır. İkindi ve yüksek enlem kuralları ile dakika düzeltmeleri uygulanmaya devam eder."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "روش سفارشی از زاویه‌های فجر و عشای شما استفاده می‌کند. قواعد عصر، عرض‌های جغرافیایی بالا و تنظیم دقیقه‌ها همچنان اعمال می‌شوند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নিজস্ব পদ্ধতি আপনার ফজর ও এশার কোণ ব্যবহার করে। আসর, উচ্চ অক্ষাংশের নিয়ম ও মিনিটের সমন্বয়ও প্রযোজ্য থাকে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaedah tersuai menggunakan sudut Subuh dan Isyak anda. Peraturan Asar, latitud tinggi dan pelarasan minit masih terpakai."
          }
        }
      }
    },
