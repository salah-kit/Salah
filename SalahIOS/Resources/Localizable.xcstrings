    "Seventh of the night above 48°; middle of the night elsewhere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seventh of the night above 48°; middle of the night elsewhere"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سُبع الليل بعد ٤٨°؛ ومنتصف الليل فيما عدا ذلك"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un septième de la nuit au-delà de 48° ; moitié de la nuit ailleurs"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "۴۸° سے اوپر رات کا ساتواں حصہ؛ باقی جگہ آدھی رات"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sepertujuh malam di atas 48°; tengah malam di tempat lain"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "48° üzerinde gecenin yedide biri; diğer yerlerde gecenin ortası"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یک‌هفتم شب بالاتر از ۴۸°؛ نیمه شب در جاهای دیگر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "৪৮°-এর ওপরে রাতের এক-সপ্তমাংশ; অন্যত্র মধ্যরাত"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sepertujuh malam di atas 48°; pertengahan malam di tempat lain"
          }
        }
      }
    },
