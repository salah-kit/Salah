            "state": "translated",
            "value": "Mutes Salah sounds. Your prayer notifications and reminders still arrive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يكتم أصوات صلاة. تستمر إشعارات الصلاة والتذكيرات في الوصول."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coupe les sons de Salah. Les notifications de prière et rappels arrivent toujours."
          }
