        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کوئی شہر نہیں ملا۔ شہر اور ملک کا نام آزمائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kota tidak ditemukan. Coba nama kota dan negara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şehir bulunamadı. Şehir ve ülke adını deneyin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شهری یافت نشد. نام شهر و کشور را امتحان کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কোনো শহর পাওয়া যায়নি। শহর ও দেশের নাম দিয়ে চেষ্টা করুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada bandar ditemui. Cuba nama bandar dan negara."
