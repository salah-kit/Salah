    "Move your device in a figure 8, away from metal and magnets, to improve compass accuracy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move your device in a figure 8, away from metal and magnets, to improve compass accuracy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حرّك الجهاز على شكل ٨ بعيدًا عن المعادن والمغناطيس لتحسين دقة البوصلة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacez l’appareil en dessinant un 8, loin du métal et des aimants, pour améliorer la précision."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قطب نما کی درستگی بہتر بنانے کے لیے آلے کو دھات اور مقناطیس سے دور ۸ کی شکل میں حرکت دیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gerakkan perangkat membentuk angka 8, jauh dari logam dan magnet, untuk meningkatkan akurasi kompas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pusula doğruluğunu artırmak için aygıtınızı metal ve mıknatıslardan uzakta 8 çizerek hareket ettirin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای بهبود دقت قطب‌نما، دستگاه را دور از فلز و آهن‌ربا به شکل ۸ حرکت دهید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কম্পাসের নির্ভুলতা বাড়াতে ধাতু ও চুম্বক থেকে দূরে ডিভাইসটি ৮-এর আকারে ঘোরান।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gerakkan peranti dalam bentuk angka 8, jauh daripada logam dan magnet, untuk meningkatkan ketepatan kompas."
          }
        }
      }
    },
