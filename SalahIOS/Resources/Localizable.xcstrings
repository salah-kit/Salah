    "Above 48°, Recommended uses the seventh of the night for Fajr and Isha.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above 48°, Recommended uses the seventh of the night for Fajr and Isha."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بعد خط عرض ٤٨°، يستخدم الخيار الموصى به سُبع الليل للفجر والعشاء."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Au-delà de 48°, le réglage recommandé utilise un septième de la nuit pour le Fajr et l’Isha."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "۴۸° سے اوپر، تجویز کردہ اصول فجر اور عشاء کے لیے رات کا ساتواں حصہ استعمال کرتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di atas 48°, aturan Disarankan menggunakan sepertujuh malam untuk Subuh dan Isya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "48° üzerinde, Önerilen kural imsak ve yatsı için gecenin yedide birini kullanır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بالاتر از ۴۸°، گزینه پیشنهادی برای فجر و عشا از یک‌هفتم شب استفاده می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "৪৮°-এর ওপরে প্রস্তাবিত নিয়ম ফজর ও এশার জন্য রাতের এক-সপ্তমাংশ ব্যবহার করে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di atas 48°, pilihan Disyorkan menggunakan sepertujuh malam untuk Subuh dan Isyak."
          }
        }
      }
    },
    "Add or subtract up to 3 days for your local moon sighting. This also adjusts when Ramadan begins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add or subtract up to 3 days for your local moon sighting. This also adjusts when Ramadan begins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضف أو اطرح حتى ٣ أيام وفق رؤية الهلال المحلية. يضبط هذا أيضًا بداية رمضان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez ou retirez jusqu’à 3 jours selon l’observation locale de la lune. Cela ajuste aussi le début du Ramadan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مقامی رویتِ ہلال کے مطابق ۳ دن تک آگے یا پیچھے کریں۔ اس سے رمضان کا آغاز بھی تبدیل ہوتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambah atau kurangi hingga 3 hari sesuai pengamatan hilal setempat. Ini juga menyesuaikan awal Ramadan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yerel hilal gözleminize göre en fazla 3 gün ekleyin veya çıkarın. Bu, Ramazan’ın başlangıcını da düzeltir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بر اساس رؤیت هلال محلی تا ۳ روز اضافه یا کم کنید. این کار آغاز رمضان را نیز جابه‌جا می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "স্থানীয় চাঁদ দেখার হিসাবে সর্বোচ্চ ৩ দিন যোগ বা বিয়োগ করুন। এতে রমজানের শুরুও সমন্বিত হয়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tambah atau tolak sehingga 3 hari mengikut cerapan anak bulan setempat. Ini turut melaraskan permulaan Ramadan."
          }
        }
      }
    },
