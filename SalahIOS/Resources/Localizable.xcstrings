    },
    "No prayer times are available for this date. Review calculation settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No prayer times are available for this date. Review calculation settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تتوفر أوقات الصلاة لهذا التاريخ. راجع إعدادات الحساب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun horaire disponible pour cette date. Vérifiez les réglages de calcul."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس تاریخ کے لیے اوقاتِ نماز دستیاب نہیں۔ حساب کی ترتیبات دیکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu salat tidak tersedia untuk tanggal ini. Tinjau pengaturan perhitungan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu tarih için namaz vakti yok. Hesaplama ayarlarını gözden geçirin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای این تاریخ اوقات نمازی در دسترس نیست. تنظیمات محاسبه را بررسی کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই তারিখে নামাজের সময় পাওয়া যাচ্ছে না। গণনার সেটিংস দেখুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada waktu solat tersedia untuk tarikh ini. Semak seting pengiraan."
          }
        }
      }
    },
