        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم حفظ تنبيهات الصلاة. فعّل التنبيهات من الإعدادات لاستلامها. قد يؤخر التركيز والملخص المجدول وصولها."
          }
        },
        "fr": {
          "stringUnit": {
