    "Sunrise marks the day; it is not a prayer. Choose a sound if you want an alert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise marks the day; it is not a prayer. Choose a sound if you want an alert."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الشروق بداية النهار وليس صلاة. اختر صوتًا إذا أردت تنبيهًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le lever du soleil est un repère du jour, pas une prière. Choisissez un son si vous souhaitez une alerte."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلوعِ آفتاب دن کی نشانی ہے؛ یہ نماز نہیں۔ تنبیہ چاہیے تو آواز منتخب کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Matahari terbit menandai hari; ini bukan salat. Pilih suara jika Anda menginginkan peringatan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Güneşin doğuşu günün bir olayıdır; namaz değildir. Uyarı istiyorsanız bir ses seçin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلوع نشان روز است؛ نماز نیست. اگر هشدار می‌خواهید، صدایی انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সূর্যোদয় দিনের একটি ঘটনা; এটি নামাজ নয়। সতর্কতা চাইলে শব্দ বেছে নিন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Syuruk menandakan hari; ia bukan solat. Pilih bunyi jika anda mahukan peringatan."
          }
        }
      }
    },
