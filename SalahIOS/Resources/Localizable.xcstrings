    "Automatic uses a country suggestion when available; otherwise your chosen method stays. You can always choose manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses a country suggestion when available; otherwise your chosen method stays. You can always choose manually."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم الوضع التلقائي اقتراح البلد عند توفره؛ وإلا تبقى طريقتك المختارة. يمكنك الاختيار يدويًا دائمًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mode automatique utilise la méthode suggérée pour le pays, si disponible ; sinon votre méthode choisie est conservée. Vous pouvez toujours choisir manuellement."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خودکار طریقہ دستیاب ہونے پر ملک کی تجویز استعمال کرتا ہے؛ ورنہ آپ کا منتخب طریقہ برقرار رہتا ہے۔ آپ ہمیشہ خود بھی منتخب کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otomatis memakai saran negara jika tersedia; jika tidak, metode pilihan Anda tetap digunakan. Anda selalu dapat memilih secara manual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otomatik, varsa ülke önerisini kullanır; yoksa seçtiğiniz yöntem korunur. Her zaman elle seçim yapabilirsiniz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حالت خودکار از پیشنهاد کشور، در صورت وجود، استفاده می‌کند؛ وگرنه روش انتخابی شما حفظ می‌شود. همیشه می‌توانید دستی انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "স্বয়ংক্রিয় পদ্ধতি দেশের প্রস্তাবিত পদ্ধতি থাকলে তা ব্যবহার করে; নইলে আপনার নির্বাচিত পদ্ধতি বজায় থাকে। সবসময় নিজেও বেছে নিতে পারবেন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatik menggunakan cadangan negara jika tersedia; jika tiada, kaedah pilihan anda dikekalkan. Anda sentiasa boleh memilih secara manual."
          }
        }
      }
    },
