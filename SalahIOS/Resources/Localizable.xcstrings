    "Notifications use a prepared clip under 30 seconds. The full recording can play inside Salah.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications use a prepared clip under 30 seconds. The full recording can play inside Salah."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تستخدم الإشعارات مقطعًا معدًا أقل من ٣٠ ثانية. يمكن تشغيل التسجيل الكامل داخل تطبيق صلاة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les notifications utilisent un extrait préparé de moins de 30 secondes. L’enregistrement complet peut être lu dans Salah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اطلاعات ۳۰ سیکنڈ سے چھوٹا تیار شدہ کلپ استعمال کرتی ہیں۔ مکمل ریکارڈنگ Salah کے اندر چل سکتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notifikasi memakai cuplikan yang disiapkan di bawah 30 detik. Rekaman lengkap dapat diputar di Salah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bildirimler 30 saniyeden kısa hazırlanmış bir klip kullanır. Tam kayıt Salah içinde çalınabilir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعلان‌ها از قطعه آماده‌شده کمتر از ۳۰ ثانیه استفاده می‌کنند. ضبط کامل در Salah پخش می‌شود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "বিজ্ঞপ্তিতে ৩০ সেকেন্ডের কম প্রস্তুত ক্লিপ ব্যবহৃত হয়। পুরো রেকর্ডিং Salah-এর ভেতরে চালানো যায়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemberitahuan menggunakan klip yang disediakan di bawah 30 saat. Rakaman penuh boleh dimainkan dalam Salah."
          }
        }
      }
    },
