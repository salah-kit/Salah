    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to calculate prayer times and the direction of the Qibla. You can choose a city instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُستخدم موقعك لحساب أوقات الصلاة واتجاه القبلة. يمكنك اختيار مدينة بدلاً من ذلك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre position permet de calculer les heures de prière et la direction de la qibla. Vous pouvez choisir une ville à la place."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کا مقام نماز کے اوقات اور قبلے کی سمت کا حساب لگانے کے لیے استعمال ہوتا ہے۔ آپ اس کے بجائے شہر منتخب کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi Anda digunakan untuk menghitung waktu salat dan arah kiblat. Anda juga dapat memilih kota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konumunuz, namaz vakitlerini ve kıble yönünü hesaplamak için kullanılır. Bunun yerine bir şehir seçebilirsiniz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "از موقعیت شما برای محاسبه اوقات نماز و جهت قبله استفاده می‌شود. می‌توانید به‌جای آن شهری را انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নামাজের সময় ও কিবলার দিক নির্ণয় করতে আপনার অবস্থান ব্যবহার করা হয়। এর পরিবর্তে আপনি একটি শহর বেছে নিতে পারেন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi anda digunakan untuk mengira waktu solat dan arah kiblat. Anda boleh memilih bandar sebagai ganti."
          }
        }
      }
    }
  },
  "version": "1.0"
}
