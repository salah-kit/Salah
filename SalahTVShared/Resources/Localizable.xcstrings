    "Hanafi Asr begins when a shadow is twice its object’s length; the others, when it’s equal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanafi Asr begins when a shadow is twice its object’s length; the others, when it’s equal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبدأ العصر عند الحنفية عندما يصبح الظل ضعفي طول الجسم، وعند غيرهم عندما يساويه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour l’école hanafite, l’Asr commence quand l’ombre mesure deux fois la longueur de l’objet ; pour les autres, quand elle l’égale."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حنفی مسلک میں عصر تب شروع ہوتی ہے جب سایہ شے کی لمبائی سے دوگنا ہو؛ دیگر میں جب برابر ہو۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asar Hanafi dimulai saat bayangan dua kali panjang bendanya; mazhab lain, saat sama panjang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hanefi ikindisi, gölge cismin boyunun iki katı olduğunda başlar; diğerlerinde eşit olduğunda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عصر حنفی وقتی آغاز می‌شود که طول سایه دو برابر طول جسم باشد؛ در سایر مذاهب، وقتی برابر باشد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "হানাফি মতে আসর শুরু হয় যখন ছায়া বস্তুর দৈর্ঘ্যের দ্বিগুণ হয়; অন্যদের মতে, যখন সমান হয়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asar Hanafi bermula apabila bayang dua kali panjang objeknya; mazhab lain, apabila sama panjang."
          }
        }
      }
    },
