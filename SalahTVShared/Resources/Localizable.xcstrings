    "Your location and settings stay on this Apple TV. Finding your city sends this Apple TV’s location, or the city you search for, to Apple Maps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location and settings stay on this Apple TV. Finding your city sends this Apple TV’s location, or the city you search for, to Apple Maps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبقى موقعك وإعداداتك على جهاز Apple TV هذا. لمعرفة مدينتك يُرسَل موقع الجهاز أو اسم المدينة التي تبحث عنها إلى خرائط Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre position et vos réglages restent sur cette Apple TV. Pour trouver votre ville, la position de cette Apple TV ou la ville recherchée est envoyée à Plans d’Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کا مقام اور ترتیبات اسی Apple TV پر رہتی ہیں۔ آپ کا شہر معلوم کرنے کے لیے اس Apple TV کا مقام، یا آپ کا تلاش کردہ شہر، Apple Maps کو بھیجا جاتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi dan pengaturan Anda tetap di Apple TV ini. Untuk menemukan kota Anda, lokasi Apple TV ini atau kota yang Anda cari dikirim ke Apple Maps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konumunuz ve ayarlarınız bu Apple TV’de kalır. Şehrinizi bulmak için bu Apple TV’nin konumu veya aradığınız şehir Apple Harita’ya gönderilir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "موقعیت و تنظیمات شما روی این Apple TV می‌ماند. برای یافتن شهرتان، موقعیت این Apple TV یا شهری که جستجو می‌کنید به Apple Maps فرستاده می‌شود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অবস্থান ও সেটিংস এই Apple TV-তেই থাকে। আপনার শহর খুঁজতে এই Apple TV-এর অবস্থান, অথবা আপনি যে শহর খোঁজেন, Apple Maps-এ পাঠানো হয়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokasi dan seting anda kekal pada Apple TV ini. Untuk mencari bandar anda, lokasi Apple TV ini atau bandar yang anda cari dihantar ke Peta Apple."
          }
        }
      }
    },
