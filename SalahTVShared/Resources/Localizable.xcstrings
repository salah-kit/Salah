    "Location access is off for Salah. Turn it on in Settings, or choose a city.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off for Salah. Turn it on in Settings, or choose a city."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوصول إلى الموقع متوقف لتطبيق صلاة. شغّله من الإعدادات، أو اختر مدينة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à la position est désactivé pour Salah. Activez-le dans Réglages ou choisissez une ville."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah کے لیے مقام تک رسائی بند ہے۔ اسے ترتیبات میں فعال کریں، یا شہر منتخب کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi nonaktif untuk Salah. Aktifkan di Pengaturan, atau pilih kota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah için konum erişimi kapalı. Ayarlar’dan açın veya bir şehir seçin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دسترسی به موقعیت برای Salah خاموش است. آن را در تنظیمات روشن کنید یا شهری انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah-এর জন্য অবস্থান ব্যবহারের অনুমতি বন্ধ। সেটিংসে চালু করুন, অথবা শহর বেছে নিন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses lokasi dimatikan untuk Salah. Hidupkan dalam Seting, atau pilih bandar."
          }
        }
      }
    },
