    "A spoken du’a follows the adhan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A spoken du’a follows the adhan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُتلى الدعاء بعد الأذان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une du’a récitée suit l’adhan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اذان کے بعد دعا پڑھی جاتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doa yang dibacakan menyusul setelah azan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ezandan sonra sesli dua okunur."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "پس از اذان، دعایی خوانده می‌شود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আজানের পর পাঠ করা দোয়া শোনানো হয়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doa yang dibacakan menyusul selepas azan."
          }
        }
      }
    },
