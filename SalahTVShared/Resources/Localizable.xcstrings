          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "উম্মুল কুরা, স্থানীয় চাঁদ দেখার সঙ্গে মেলাতে সর্বোচ্চ তিন দিন সরানো।"
