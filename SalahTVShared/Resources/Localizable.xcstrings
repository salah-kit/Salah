    "On Fridays, Jumu’ah uses Dhuhr’s sound.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Fridays, Jumu’ah uses Dhuhr’s sound."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوم الجمعة، تستخدم صلاة الجمعة صوت الظهر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le vendredi, Joumouah utilise le son du Dhuhr."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جمعے کے دن، جمعہ کے لیے ظہر کی آواز استعمال ہوتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pada hari Jumat, salat Jumat memakai suara Zuhur."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuma günleri cuma namazı öğle sesini kullanır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "روزهای جمعه، نماز جمعه از صدای ظهر استفاده می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শুক্রবারে জুমা যোহরের শব্দ ব্যবহার করে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pada hari Jumaat, solat Jumaat menggunakan bunyi Zohor."
          }
        }
      }
    },
