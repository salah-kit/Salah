        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أم القرى، مع تحريك حتى ثلاثة أيام ليوافق رؤية الهلال المحلية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umm al-Qura, décalé jusqu’à trois jours selon l’observation locale de la lune."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ام القریٰ، مقامی رویتِ ہلال کے مطابق تین دن تک آگے یا پیچھے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ummul Qura, digeser hingga tiga hari sesuai pengamatan hilal setempat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ümmü’l-Kurâ, yerel hilal gözlemine göre en fazla üç gün kaydırılır."
