    "Plays at the prayer’s time while Salah is open. Choosing a sound plays it once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays at the prayer’s time while Salah is open. Choosing a sound plays it once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُشغَّل عند وقت الصلاة ما دام تطبيق صلاة مفتوحًا. اختيار صوت يشغّله مرة واحدة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Joué à l’heure de la prière quand Salah est ouvert. Choisir un son le fait entendre une fois."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah کھلا ہونے پر نماز کے وقت چلتی ہے۔ آواز منتخب کرنے پر وہ ایک بار چلتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diputar pada waktu salat saat Salah terbuka. Memilih suara akan memutarnya sekali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah açıkken namaz vaktinde çalar. Seçtiğiniz ses bir kez çalınır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تا وقتی Salah باز است، در وقت نماز پخش می‌شود. انتخاب صدا آن را یک بار پخش می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah খোলা থাকলে নামাজের সময়ে বাজে। শব্দ বেছে নিলে তা একবার বাজে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dimainkan pada waktu solat semasa Salah dibuka. Memilih bunyi akan memainkannya sekali."
          }
        }
      }
    },
