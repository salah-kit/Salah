    "Salah uses this Apple TV’s location once to find your city and its time zone. Choosing a city needs no permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah uses this Apple TV’s location once to find your city and its time zone. Choosing a city needs no permission."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم تطبيق صلاة موقع جهاز Apple TV هذا مرة واحدة لمعرفة مدينتك ومنطقتها الزمنية. واختيار مدينة لا يحتاج إلى إذن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah utilise une fois la position de cette Apple TV pour trouver votre ville et son fuseau horaire. Choisir une ville ne nécessite aucune autorisation."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah آپ کا شہر اور اس کا ٹائم زون معلوم کرنے کے لیے اس Apple TV کا مقام ایک بار استعمال کرتا ہے۔ شہر منتخب کرنے کے لیے کسی اجازت کی ضرورت نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah menggunakan lokasi Apple TV ini sekali untuk menemukan kota Anda dan zona waktunya. Memilih kota tidak memerlukan izin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah, şehrinizi ve saat dilimini bulmak için bu Apple TV’nin konumunu bir kez kullanır. Şehir seçmek izin gerektirmez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah یک بار از موقعیت این Apple TV استفاده می‌کند تا شهر شما و منطقه زمانی آن را پیدا کند. انتخاب شهر به اجازه نیاز ندارد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার শহর ও তার সময় অঞ্চল খুঁজতে Salah এই Apple TV-এর অবস্থান একবার ব্যবহার করে। শহর বেছে নিতে কোনো অনুমতি লাগে না।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah menggunakan lokasi Apple TV ini sekali untuk mencari bandar anda dan zon waktunya. Memilih bandar tidak memerlukan kebenaran."
          }
        }
      }
    },
    "Salah uses this Apple TV’s location once to find your city and its time zone. Or choose a city yourself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah uses this Apple TV’s location once to find your city and its time zone. Or choose a city yourself."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم تطبيق صلاة موقع جهاز Apple TV هذا مرة واحدة لمعرفة مدينتك ومنطقتها الزمنية. أو اختر مدينة بنفسك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah utilise une fois la position de cette Apple TV pour trouver votre ville et son fuseau horaire. Ou choisissez vous-même une ville."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah آپ کا شہر اور اس کا ٹائم زون معلوم کرنے کے لیے اس Apple TV کا مقام ایک بار استعمال کرتا ہے۔ یا خود شہر منتخب کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah menggunakan lokasi Apple TV ini sekali untuk menemukan kota Anda dan zona waktunya. Atau pilih kota sendiri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah, şehrinizi ve saat dilimini bulmak için bu Apple TV’nin konumunu bir kez kullanır. Ya da şehri kendiniz seçin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah یک بار از موقعیت این Apple TV استفاده می‌کند تا شهر شما و منطقه زمانی آن را پیدا کند. یا خودتان شهری انتخاب کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার শহর ও তার সময় অঞ্চল খুঁজতে Salah এই Apple TV-এর অবস্থান একবার ব্যবহার করে। অথবা নিজেই শহর বেছে নিন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah menggunakan lokasi Apple TV ini sekali untuk mencari bandar anda dan zon waktunya. Atau pilih bandar sendiri."
          }
        }
      }
    },
