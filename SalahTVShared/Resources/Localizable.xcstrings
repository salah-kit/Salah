    "The adhan plays at each prayer while Salah is open. Apple TV can’t play it when Salah is closed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The adhan plays at each prayer while Salah is open. Apple TV can’t play it when Salah is closed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُرفع الأذان عند كل صلاة ما دام تطبيق صلاة مفتوحًا. لا يستطيع Apple TV تشغيله وصلاة مغلق."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’adhan retentit à chaque prière quand Salah est ouvert. Apple TV ne peut pas le jouer quand Salah est fermé."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah کھلا ہونے پر ہر نماز پر اذان چلتی ہے۔ Salah بند ہونے پر Apple TV اسے نہیں چلا سکتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Azan diputar di setiap waktu salat saat Salah terbuka. Apple TV tidak dapat memutarnya saat Salah ditutup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah açıkken her namazda ezan çalar. Salah kapalıyken Apple TV ezanı çalamaz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تا وقتی Salah باز است، اذان در هر نماز پخش می‌شود. وقتی Salah بسته است، Apple TV نمی‌تواند آن را پخش کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah খোলা থাকলে প্রতি নামাজে আজান বাজে। Salah বন্ধ থাকলে Apple TV তা বাজাতে পারে না।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Azan dimainkan pada setiap waktu solat semasa Salah dibuka. Apple TV tidak dapat memainkannya apabila Salah ditutup."
          }
        }
      }
    },
    "The du’a after the adhan follows": {
