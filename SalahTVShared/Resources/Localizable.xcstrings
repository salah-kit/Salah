            "state": "needs_review",
            "value": "Le mode de calcul du Fajr et de l’Isha. Automatique suit la méthode en usage dans le pays."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فجر اور عشاء کا حساب کیسے ہوتا ہے۔ خودکار ملک میں رائج طریقہ اپناتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cara Subuh dan Isya dihitung. Otomatis mengikuti metode yang digunakan di negara tersebut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İmsak ve yatsının nasıl hesaplandığı. Otomatik, ülkede kullanılan yöntemi izler."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نحوه محاسبه فجر و عشا. حالت خودکار از روش رایج در کشور پیروی می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ফজর ও এশা কীভাবে গণনা হয়। স্বয়ংক্রিয় বিকল্প দেশে প্রচলিত পদ্ধতি অনুসরণ করে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cara Subuh dan Isyak dikira. Automatik mengikut kaedah yang digunakan di negara itu."
          }
        }
      }
    },
