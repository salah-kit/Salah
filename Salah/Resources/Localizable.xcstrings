    "today.keepsRunning.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق هذه النافذة وتستمر أوقات الصلاة والأذان. أنهه لإيقافها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this window and prayer times and the adhan carry on. Quit to stop them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermez cette fenêtre : les heures de prière et l’adhan continuent. Quittez Salah pour les arrêter."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ ونڈو بند کرنے پر بھی نماز کے اوقات اور اذان جاری رہتے ہیں۔ انہیں روکنے کے لیے Salah بند کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutup jendela ini, waktu salat dan azan tetap berjalan. Keluar dari Salah untuk menghentikannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu pencereyi kapatsanız da namaz vakitleri ve ezan devam eder. Durdurmak için Salah’tan çıkın."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "با بستن این پنجره، اوقات نماز و اذان ادامه می‌یابند. برای توقف آن‌ها از Salah خارج شوید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই উইন্ডো বন্ধ করলেও নামাজের সময় ও আজান চলতে থাকে। থামাতে Salah বন্ধ করুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutup tetingkap ini, waktu solat dan azan diteruskan. Keluar dari Salah untuk menghentikannya."
          }
        }
      }
    },
    "today.keepsRunning.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى «صلاة» يعمل في شريط القائمة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah keeps running in the menu bar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah continue de fonctionner dans la barre des menus"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah مینیو بار میں چلتی رہتی ہے"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah tetap berjalan di bilah menu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah menü çubuğunda çalışmaya devam eder"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah در نوار منو به کار خود ادامه می‌دهد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah মেনু বারে চলতে থাকে"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salah terus berjalan di bar menu"
          }
        }
      }
    },
