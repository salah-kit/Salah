        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹیفکیشن کی اجازت کو سسٹم کی ترتیبات میں توجہ درکار ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin notifikasi perlu diperiksa di Pengaturan Sistem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni Sistem Ayarları'nda dikkat gerektiriyor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازه اعلان در تنظیمات سیستم نیاز به بررسی دارد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংসে বিজ্ঞপ্তির অনুমতির দিকে মনোযোগ প্রয়োজন।"
          }
        },
        "ms": {
          "stringUnit": {
