          "stringUnit": {
            "state": "translated",
            "value": "Salah نوٹیفکیشن کی اجازت طلب نہیں کر سکا۔ سسٹم کی ترتیبات چیک کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah tidak dapat meminta izin notifikasi. Periksa Pengaturan Sistem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah bildirim izni isteyemedi. Sistem Ayarları'nı kontrol edin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah نتوانست اجازه اعلان را درخواست کند. تنظیمات سیستم را بررسی کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah বিজ্ঞপ্তির অনুমতি চাইতে পারেনি। সিস্টেম সেটিংস পরীক্ষা করুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah tidak dapat meminta kebenaran pemberitahuan. Semak Tetapan Sistem."
          }
        }
      }
    },
    "settings.notif.permission.unknown": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج أذونات التنبيهات إلى مراجعة في إعدادات النظام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission needs attention in System Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
