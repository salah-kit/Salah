    "note.stillRunning.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر أوقات الصلاة والأذان من هنا. لإيقاف «صلاة»، افتح هذه القائمة وانقر زر الإنهاء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times and the adhan carry on from up here. To turn Salah off, open this menu and click the power button."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les heures de prière et l’adhan continuent depuis ici. Pour arrêter Salah, ouvrez ce menu et cliquez sur le bouton d’alimentation."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نماز کے اوقات اور اذان یہیں سے جاری رہتے ہیں۔ Salah بند کرنے کے لیے یہ مینیو کھولیں اور پاور بٹن پر کلک کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu salat dan azan tetap berjalan dari sini. Untuk mematikan Salah, buka menu ini lalu klik tombol daya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Namaz vakitleri ve ezan buradan devam eder. Salah’ı kapatmak için bu menüyü açıp güç düğmesine tıklayın."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اوقات نماز و اذان از همین‌جا ادامه می‌یابند. برای خاموش کردن Salah، این منو را باز کنید و روی دکمهٔ خاموش کلیک کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নামাজের সময় ও আজান এখান থেকেই চলতে থাকে। Salah বন্ধ করতে এই মেনু খুলে পাওয়ার বোতামে ক্লিক করুন।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waktu solat dan azan diteruskan dari sini. Untuk mematikan Salah, buka menu ini dan klik butang kuasa."
          }
        }
      }
    },
