        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah کے نوٹیفکیشنز سسٹم کی ترتیبات میں بند ہیں۔ انہیں سسٹم کی ترتیبات میں فعال کریں۔"
          }
        },
        "id": {
