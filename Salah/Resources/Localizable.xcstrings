          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌های Salah در تنظیمات سیستم خاموش است. آن‌ها را در تنظیمات سیستم فعال کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংসে Salah-এর বিজ্ঞপ্তি বন্ধ আছে। সিস্টেম সেটিংস থেকে এগুলো সক্রিয় করুন।"
          }
        },
        "ms": {
          "stringUnit": {
