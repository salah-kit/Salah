    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "توقف صلاة تطبيق الموسيقى أو iTunes مؤقتًا قبل تشغيل الأذان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah pauses Music or iTunes before playing the adhan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah met Music ou iTunes en pause avant de lancer l'adhan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اذان چلانے سے پہلے Salah، Music یا iTunes کو موقوف کر دیتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah menjeda Music atau iTunes sebelum memutar azan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah, ezanı çalmadan önce Music veya iTunes'u duraklatır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah پیش از پخش اذان، Music یا iTunes را موقتاً متوقف می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজান বাজানোর আগে Salah, Music বা iTunes সাময়িকভাবে থামায়।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah menjeda Music atau iTunes sebelum memainkan azan."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم «صلاة» موقعك لحساب أوقات الصلاة فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah uses your location only to calculate prayer times."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah utilise votre position uniquement pour calculer les heures de prière."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah آپ کا مقام صرف نماز کے اوقات کے حساب کے لیے استعمال کرتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah memakai lokasi Anda hanya untuk menghitung waktu salat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah, konumunuzu yalnızca namaz vakitlerini hesaplamak için kullanır."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah از موقعیت شما فقط برای محاسبهٔ اوقات نماز استفاده می‌کند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah আপনার অবস্থান শুধু নামাজের সময় হিসাব করতে ব্যবহার করে।"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah menggunakan lokasi anda hanya untuk mengira waktu solat."
          }
        }
      }
    },
